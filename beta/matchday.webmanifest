{
  "id": "./matchday.html",
  "name": "EUYFC Live Match Recorder",
  "short_name": "EUYFC Live",
  "description": "Live Eastbourne United scoring, match activity and matchday photos.",
  "start_url": "./matchday.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "prefer_related_applications": false,
  "background_color": "#030806",
  "theme_color": "#06110b",
  "icons": [
    { "src": "assets/euyfc-live-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/euyfc-live-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
